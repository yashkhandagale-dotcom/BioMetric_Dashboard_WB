# Copy this file to .env (or .env.local) and set real values.
#
# ── UNIFIED PROJECT ──────────────────────────────────────────────────────
# One Supabase project now backs both the Dashboard and the Leave Tracker
# (see unified_schema.sql). Both apps' Supabase client files read these
# same three vars — there is no separate "leave" URL/key set anymore.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── GOOGLE OAUTH LOGIN ───────────────────────────────────────────────────
# No app-level env vars needed for this part — Google sign-in is
# configured entirely in the Supabase Dashboard (Authentication ->
# Providers -> Google: Client ID + Client Secret from a Google Cloud
# OAuth 2.0 Web Client, and add this app's
# {SUPABASE_URL}/auth/v1/callback as an authorized redirect URI on the
# Google Cloud OAuth client). See app/api/auth/callback/route.ts for the
# app-side half of this flow.
#
# Optional — restricts normal (non-admin) sign-in to this email domain.
# Defaults to 'wonderbiz.in' if unset. See app/api/auth/callback/route.ts.
COMPANY_EMAIL_DOMAIN=wonderbiz.in

# ── GOOGLE WORKSPACE DIRECTORY SYNC (optional) ──────────────────────────
# Only needed for the "Sync Google Directory" admin button (Admin panel
# header). Not required for Google OAuth *login* above, and not required
# for normal Admin employee creation, which works with none of this set.
# See lib/googleWorkspace.ts for full setup steps (service account,
# domain-wide delegation, required scope).
# GOOGLE_WORKSPACE_SERVICE_ACCOUNT_JSON=paste-the-full-service-account-json-here-as-one-line-or-base64
# GOOGLE_WORKSPACE_ADMIN_EMAIL=admin@wonderbiz.in
# GOOGLE_WORKSPACE_DOMAIN=wonderbiz.in
